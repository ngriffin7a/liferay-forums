# ---------------------------------------------------------------------------
# .env.example – Environment variables for local forums-microservice runs
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# When deploying to Liferay PaaS, set these same variables in the
# service's "Environment Variables" section of the PaaS Console
# (Liferay Cloud Console → Service → Environment Variables).
# ---------------------------------------------------------------------------

# Liferay base URL the microservice calls for JWKS validation and for the
# headless API callbacks (subscriber lookup, message-title fetch,
# notification-queue POST, display-page URL construction).
# Local dev: http://localhost:8080
# PaaS:      https://webserver-<project>-<env>.lfr.cloud
LIFERAY_BASE_URL=http://localhost:8080

# Liferay DXP host and protocol for the LXC configtree. These feed the OAuth2
# resource-server config that validates the object-action JWTs, so they MUST
# match the Liferay instance that issues those tokens.
# Local dev: localhost:8080 / http
# PaaS:      webserver-<project>-<env>.lfr.cloud / https
LIFERAY_DXP_HOST=localhost:8080
LIFERAY_DXP_PROTOCOL=http

# Optional Basic Auth fallback for LiferayApiClient, used ONLY when no JWT is
# forwarded on a call. Defaults to the standard local-bundle admin
# (test@liferay.com / test) when unset; override for other environments.
# LIFERAY_HEADLESS_API_USER=test@liferay.com
# LIFERAY_HEADLESS_API_PASSWORD=test

# ---------------------------------------------------------------------------
# Forum notification identity & links
#
# Email is delivered through Liferay's notification-queue REST API (no SMTP
# here). These control the From identity on those notifications and the base
# URL prepended to the display-page links in email/web notifications.
# ---------------------------------------------------------------------------
FORUMS_EMAIL_FROM=forums-noreply@example.xyz
FORUMS_EMAIL_FROM_NAME=Community Forums

# Base URL prepended to the site-relative display-page path in notifications.
# Set to your Liferay host so the links resolve, e.g.
# https://webserver-<project>-<env>.lfr.cloud
FORUMS_SITE_BASE_URL=https://webserver-lctexample-prd.lfr.cloud
