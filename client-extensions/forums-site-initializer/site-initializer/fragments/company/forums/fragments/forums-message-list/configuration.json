{
	"fieldSets": [
		{
			"label": "Content",
			"fields": [
				{
					"dataType": "string",
					"defaultValue": "20",
					"label": "Messages Per Page",
					"name": "pageSize",
					"type": "text"
				},
				{
					"dataType": "string",
					"defaultValue": "/forums",
					"label": "Community Home URL",
					"name": "communityURL",
					"type": "text"
				},
				{
					"defaultValue": true,
					"label": "Show Search Bar",
					"name": "showSearchBar",
					"type": "checkbox"
				}
			]
		},
		{
			"label": "Appearance",
			"fields": [
				{
					"dataType": "string",
					"defaultValue": "forums-ui-standard",
					"label": "UI Style",
					"name": "uiStyle",
					"type": "select",
					"typeOptions": {
						"validValues": [
							{
								"label": "Standard",
								"value": "forums-ui-standard"
							},
							{
								"label": "Flat",
								"value": "forums-ui-flat"
							}
						]
					}
				}
			]
		}
	]
}
